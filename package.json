{
  "name": "global-sphere-agri-tech",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "webapp",
    "mobileapp"
  ],
  "scripts": {
    "dev": "concurrently -n BACKEND,WEB -c blue,green \"npm:dev:backend\" \"npm:dev:webapp\"",
    "dev:backend": "npm run dev -w backend",
    "dev:webapp": "npm run dev -w webapp",
    "build": "npm run build -ws --if-present",
    "start": "npm run start -w backend",
    "lint": "eslint . --ext .js,.jsx --max-warnings=0",
    "test": "npm run test -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "jest": "^29.7.0"
  }
}